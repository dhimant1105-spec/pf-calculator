# Port the server listens on (hosts usually set this for you)
PORT=3000
# Where the SQLite database file is kept. Use a persistent disk in production.
DATA_DIR=./data
# Used only the first time the server starts, to create the administrator.
# If ADMIN_PASSWORD is left out, a random one is printed once in the server log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Set to production on a real host: secure cookies and HSTS.
NODE_ENV=production
# Hours a sign-in lasts
SESSION_HOURS=12
